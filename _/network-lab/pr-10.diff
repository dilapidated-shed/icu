+          for specification in \
+              'valid_utf8 /valid http' \
+              'malformed_html /malformed http' \
+              'empty_success /empty http' \
+              'redirect_utf8 /redirect http' \
+              'truncated_body /truncated http' \
+              'invalid_utf8 /invalid-utf8 http' \
+              'unknown_charset /unknown-charset http' \
+              'truncated_gzip /gzip-truncated http' \
+              'not_found /not-found http' \
+              'tls_plaintext / https'; do
+            set -- $specification
+            fixture=$1
+            path=$2
+            scheme=$3
+            url="$scheme://127.0.0.1:18099$path"
+
+            strace -f -qq -e trace=execve \
