module Main

import Http
import System

%default total

check : String → Bool → IO ()
check name True = putStrLn ("ok   " ++ name)
check name False = putStrLn ("FAIL " ++ name)

https_default : Bool
https_default =
  case parse_url "https://example.com/a?b=1#fragment" of
    Right (https_url name number path) =>
      name == "example.com" && number == 443 && path == "/a?b=1"
    _ => False

http_explicit_port : Bool
http_explicit_port =
  case parse_url "http://localhost:8080/hello" of
    Right (http_url name number path) =>
      name == "localhost" && number == 8080 && path == "/hello"
    _ => False

reject_other_scheme : Bool
reject_other_scheme =
  case parse_url "ftp://example.com/file" of
    Left _ => True
    Right _ => False

reject_userinfo : Bool
reject_userinfo =
  case parse_url "https://name@example.com/" of
    Left _ => True
    Right _ => False

reject_header_injection : Bool
reject_header_injection =
  case parse_url "https://example.com\r\nX-Fake: yes/" of
    Left _ => True
    Right _ => False

render_get : Bool
render_get =
  case parse_url "http://example.com/" of
    Left _ => False
    Right target_url =>
      render_request (get target_url) ==
        Right
          ("GET / HTTP/1.0\r\n" ++
           "Host: example.com\r\n" ++
           "Connection: close\r\n" ++
           "Accept-Encoding: identity\r\n" ++
           "User-Agent: icu/0.1\r\n" ++
           "\r\n")

parse_authorization_header : Bool
parse_authorization_header =
  case parse_header "Authorization: Bearer example-token" of
    Right (http_header name value) =>
      name == "Authorization" && value == "Bearer example-token"
    _ => False

reject_header_value_injection : Bool
reject_header_value_injection =
  case make_header "X-Test" "safe\r\nX-Evil: yes" of
    Left _ => True
    Right _ => False

reject_framing_header : Bool
reject_framing_header =
  case make_header "Content-Length" "999" of
    Left _ => True
    Right _ => False

render_custom_get : Bool
render_custom_get =
  case parse_url "https://example.com/data" of
    Left _ => False
    Right target_url =>
      case make_header "X-Api-Key" "secret" of
        Left _ => False
        Right custom =>
          render_request_with_headers (get target_url) [custom] ==
            Right
              ("GET /data HTTP/1.0\r\n" ++
               "Host: example.com\r\n" ++
               "Connection: close\r\n" ++
               "Accept-Encoding: identity\r\n" ++
               "User-Agent: icu/0.1\r\n" ++
               "X-Api-Key: secret\r\n" ++
               "\r\n")

credential_header_surface : Bool
credential_header_surface =
  case parse_url "https://example.com/data" of
    Left _ => False
    Right target_url =>
      case make_credential_header "X-Api-Key" "secret" of
        Left _ => False
        Right custom@(credential_header name value) =>
          name == "X-Api-Key" &&
          value == "secret" &&
          credential_header_names [custom] == "X-Api-Key\n" &&
          render_request_with_headers (get target_url) [custom] ==
            Right
              ("GET /data HTTP/1.0\r\n" ++
               "Host: example.com\r\n" ++
               "Connection: close\r\n" ++
               "Accept-Encoding: identity\r\n" ++
               "User-Agent: icu/0.1\r\n" ++
               "X-Api-Key: secret\r\n" ++
               "\r\n")
        Right _ => False

replace_default_header : Bool
replace_default_header =
  case parse_url "https://example.com/message" of
    Left _ => False
    Right target_url =>
      case make_header "Content-Type" "application/json" of
        Left _ => False
        Right custom =>
          render_request_with_headers (post target_url "{}") [custom] ==
            Right
              ("POST /message HTTP/1.0\r\n" ++
               "Host: example.com\r\n" ++
               "Connection: close\r\n" ++
               "Accept-Encoding: identity\r\n" ++
               "User-Agent: icu/0.1\r\n" ++
               "Content-Type: application/json\r\n" ++
               "Content-Length: 2\r\n" ++
               "\r\n" ++
               "{}")

utf8_lengths : Bool
utf8_lengths =
  utf8_byte_length "" == 0 &&
  utf8_byte_length "ASCII" == 5 &&
  utf8_byte_length "café" == 5 &&
  utf8_byte_length "Aé€🙂" == 10

render_utf8_post : Bool
render_utf8_post =
  case parse_url "https://example.com/message" of
    Left _ => False
    Right target_url =>
      case render_request_parts (post target_url "café") of
        (wire_headers, body, body_length) =>
          wire_headers ==
            ("POST /message HTTP/1.0\r\n" ++
             "Host: example.com\r\n" ++
             "Connection: close\r\n" ++
             "Accept-Encoding: identity\r\n" ++
             "User-Agent: icu/0.1\r\n" ++
             "Content-Type: text/plain; charset=utf-8\r\n" ++
             "Content-Length: 5\r\n" ++
             "\r\n") &&
          body == "café" &&
          body_length == 5

all_pass : Bool
all_pass =
  https_default &&
  http_explicit_port &&
  reject_other_scheme &&
  reject_userinfo &&
  reject_header_injection &&
  render_get &&
  parse_authorization_header &&
  reject_header_value_injection &&
  reject_framing_header &&
  render_custom_get &&
  credential_header_surface &&
  replace_default_header &&
  utf8_lengths &&
  render_utf8_post

main : IO ()
main = do
  check "https default port, query, fragment" https_default
  check "http explicit port" http_explicit_port
  check "reject non-http scheme" reject_other_scheme
  check "reject URL userinfo" reject_userinfo
  check "reject header injection" reject_header_injection
  check "GET wire form requests identity encoding" render_get
  check "parse Authorization header" parse_authorization_header
  check "reject CRLF in caller header value" reject_header_value_injection
  check "caller cannot override Content-Length" reject_framing_header
  check "render caller-supplied GET header" render_custom_get
  check "credential header carries redirect metadata" credential_header_surface
  check "caller Content-Type replaces the default" replace_default_header
  check "UTF-8 byte lengths" utf8_lengths
  check "POST carries UTF-8 body with byte Content-Length" render_utf8_post
  if all_pass then pure () else exitFailure
