module Transport

import Network.HTTP
import Network.Transport
import Network.Types
import Network.URL

prepare_request : request → RenderedRequest

send_prepared_request :
  url →
  RenderedRequest →
  IO (Either String transport_result)

send_to_destination : url → RenderedRequest → IO Int

understand_transport_result : Int → Either String transport_result

send_using_http :
  HostName →
  DestinationPort →
  RenderedRequest →
  IO Int

send_using_https :
  HostName →
  DestinationPort →
  RenderedRequest →
  IO Int

public export
send_request : request → IO (Either String transport_result)
send_request value = do
  let prepared_request = prepare_request value
  send_prepared_request (request_url value) prepared_request

prepare_request value =
  render_request_parts value

send_prepared_request destination prepared_request = do
  result_code ← send_to_destination destination prepared_request
  pure (understand_transport_result result_code)

understand_transport_result result_code =
  transport_result_from_native_code result_code

send_to_destination
  (http_url name destination_port _)
  prepared_request =
    send_using_http name destination_port prepared_request
send_to_destination
  (https_url name destination_port _)
  prepared_request =
    send_using_https name destination_port prepared_request

-- The declarations below connect the readable transport actions above to
-- the existing C transport implementation. Nothing above needs to know
-- about PrimIO, C symbol names, or the integer calling convention.

%foreign "C:icu_send_http,libicu_transport"
system_send_http : String → Int → String → String → Int → PrimIO Int

%foreign "C:icu_send_https,libicu_transport"
system_send_https : String → Int → String → String → Int → PrimIO Int

send_using_http name destination_port prepared_request =
  primIO
    (system_send_http
      (host_name_string name)
      (destination_port_number destination_port)
      (http_request_head_text (rendered_request_head prepared_request))
      (http_body_string (rendered_request_body prepared_request))
      (cast (byte_count_number (rendered_request_body_length prepared_request))))

send_using_https name destination_port prepared_request =
  primIO
    (system_send_https
      (host_name_string name)
      (destination_port_number destination_port)
      (http_request_head_text (rendered_request_head prepared_request))
      (http_body_string (rendered_request_body prepared_request))
      (cast (byte_count_number (rendered_request_body_length prepared_request))))
