module Transport

import Network.HTTP
import Network.Transport
import Network.Types
import Network.URL

-- This transport is still implemented in native/transport.c. These two
-- primitives exist only so Idriç can cross that boundary and call the C
-- HTTP and HTTPS entry points. Ordinary transport code below should not
-- need to know about PrimIO or the C calling convention.

%foreign "C:icu_send_http,libicu_transport"
primitive_send_http : String → Int → String → String → Int → PrimIO Int

%foreign "C:icu_send_https,libicu_transport"
primitive_send_https : String → Int → String → String → Int → PrimIO Int

%foreign "C:icu_send_http_with_credentials,libicu_transport"
primitive_send_http_with_credentials :
  String → Int → String → String → Int → String → PrimIO Int

%foreign "C:icu_send_https_with_credentials,libicu_transport"
primitive_send_https_with_credentials :
  String → Int → String → String → Int → String → PrimIO Int

prepare_request : request → RenderedRequest

send_prepared_request :
  url →
  RenderedRequest →
  IO (Either String transport_result)

send_prepared_request_with_credentials :
  url →
  RenderedRequest →
  String →
  IO (Either String transport_result)

send_to_destination : url → RenderedRequest → IO Int

send_to_destination_with_credentials :
  url → RenderedRequest → String → IO Int

understand_transport_result : Int → Either String transport_result

send_using_http :
  HostName →
  DestinationPort →
  RenderedRequest →
  IO Int

send_using_https :
  HostName →
  DestinationPort →
  RenderedRequest →
  IO Int

send_using_http_with_credentials :
  HostName →
  DestinationPort →
  RenderedRequest →
  String →
  IO Int

send_using_https_with_credentials :
  HostName →
  DestinationPort →
  RenderedRequest →
  String →
  IO Int

run_transport_primitive : PrimIO Int → IO Int

credential_names_text : List HeaderName → String
credential_names_text [] = ""
credential_names_text (name :: rest) =
  header_name_text name ++ "\n" ++ credential_names_text rest

public export
send_request_with_headers :
  request → List request_header → IO (Either String transport_result)
send_request_with_headers value headers =
  case render_request_parts_with_headers value headers of
    Left problem => pure (Left problem)
    Right prepared_request =>
      let names = credential_names_text (credential_header_names headers) in
        send_prepared_request_with_credentials
          (request_url value)
          prepared_request
          names

public export
send_request : request → IO (Either String transport_result)
send_request value = do
  let prepared_request = prepare_request value
  send_prepared_request (request_url value) prepared_request

prepare_request value =
  render_request_parts value

send_prepared_request destination prepared_request = do
  result_code ← send_to_destination destination prepared_request
  pure (understand_transport_result result_code)

send_prepared_request_with_credentials
  destination
  prepared_request
  credential_names = do
    result_code ←
      send_to_destination_with_credentials
        destination
        prepared_request
        credential_names
    pure (understand_transport_result result_code)

understand_transport_result result_code =
  if result_code < 0 || result_code > 255
    then Left "native transport returned an out-of-range result code"
    else
      case transport_result_from_native_code
        (MkNativeTransportCode (cast result_code)) of
          known_transport_result decoded => Right decoded
          unknown_transport_code raw_code =>
            Left
              ("native transport returned unknown result code " ++
               show (native_transport_code_bits raw_code))

send_to_destination
  (http_url name destination_port _)
  prepared_request =
    send_using_http name destination_port prepared_request
send_to_destination
  (https_url name destination_port _)
  prepared_request =
    send_using_https name destination_port prepared_request

send_to_destination_with_credentials
  (http_url name destination_port _)
  prepared_request
  credential_names =
    send_using_http_with_credentials
      name destination_port prepared_request credential_names
send_to_destination_with_credentials
  (https_url name destination_port _)
  prepared_request
  credential_names =
    send_using_https_with_credentials
      name destination_port prepared_request credential_names

send_using_http name destination_port prepared_request = do
  let host = host_name_string name
  let port = cast (destination_port_number destination_port)
  let request_head = http_request_head_text (rendered_request_head prepared_request)
  let request_body = http_body_string (rendered_request_body prepared_request)
  let body_byte_count = byte_count_number (rendered_request_body_length prepared_request)
  let body_length = cast body_byte_count
  let primitive_action =
        primitive_send_http host port request_head request_body body_length
  run_transport_primitive primitive_action

send_using_https name destination_port prepared_request = do
  let host = host_name_string name
  let port = cast (destination_port_number destination_port)
  let request_head = http_request_head_text (rendered_request_head prepared_request)
  let request_body = http_body_string (rendered_request_body prepared_request)
  let body_byte_count = byte_count_number (rendered_request_body_length prepared_request)
  let body_length = cast body_byte_count
  let primitive_action =
        primitive_send_https host port request_head request_body body_length
  run_transport_primitive primitive_action

send_using_http_with_credentials
  name destination_port prepared_request credential_names = do
    let host = host_name_string name
    let port = cast (destination_port_number destination_port)
    let request_head =
          http_request_head_text (rendered_request_head prepared_request)
    let request_body =
          http_body_string (rendered_request_body prepared_request)
    let body_byte_count =
          byte_count_number (rendered_request_body_length prepared_request)
    let body_length = cast body_byte_count
    let primitive_action =
          primitive_send_http_with_credentials
            host port request_head request_body body_length credential_names
    run_transport_primitive primitive_action

send_using_https_with_credentials
  name destination_port prepared_request credential_names = do
    let host = host_name_string name
    let port = cast (destination_port_number destination_port)
    let request_head =
          http_request_head_text (rendered_request_head prepared_request)
    let request_body =
          http_body_string (rendered_request_body prepared_request)
    let body_byte_count =
          byte_count_number (rendered_request_body_length prepared_request)
    let body_length = cast body_byte_count
    let primitive_action =
          primitive_send_https_with_credentials
            host port request_head request_body body_length credential_names
    run_transport_primitive primitive_action

run_transport_primitive primitive_action =
  primIO primitive_action
