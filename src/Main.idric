module Main

import Network.HTTP
import Network.Transport
import Network.Types
import Network.URL
import System
import Transport
import CommandOptions


fail_with : String → IO ()
fail_with problem = do
  putStrLn problem
  exitFailure

exit_status_number : ProcessExitStatus → Int
exit_status_number status = cast (process_exit_status_bits status)

exit_code : transport_result → ExitCode
exit_code result = cast (exit_status_number (process_exit_status result))

run : List String → IO ()
run arguments =
  case checked_command_options arguments of
    Left problem ⇒ fail_with problem
    Right command ⇒ do
      outcome ← send_public_request_at_version command.version command.operation command.public_headers
      case outcome of
        Left problem ⇒ fail_with problem
        Right result ⇒ exitWith (exit_code result)

%export "dex:icu_checked_main"
main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    _ :: rest => run rest
    [] => fail_with command_usage
