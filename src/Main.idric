module Main

import Http
import OpenAI
import System
import System.File
import Transport


usage : String
usage =
  "usage:\n" ++
  "  icu get  http://host/path\n" ++
  "  icu get  https://host/path\n" ++
  "  icu post http://host/path BODY\n" ++
  "  icu post https://host/path BODY\n" ++
  "  icu openai < prompt.txt"

parse_command : List String → Either String request
parse_command ["get", text] =
  case parse_url text of
    Left problem => Left problem
    Right target_url => Right (get target_url)
parse_command ["post", text, body] =
  case parse_url text of
    Left problem => Left problem
    Right target_url => Right (post target_url body)
parse_command _ = Left usage

fail_with : String → IO ()
fail_with problem = do
  _ ← fPutStrLn stderr problem
  exitFailure

run_openai : IO ()
run_openai = do
  outcome ← query_stdin
  case outcome of
    Left problem => fail_with problem
    Right answer => putStr answer

run : List String → IO ()
run ["openai"] = run_openai
run arguments =
  case parse_command arguments of
    Left problem => fail_with problem
    Right value => do
      outcome ← send_request value
      case outcome of
        Left problem => fail_with problem
        Right status => exitWith (cast status)

main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    _ :: rest => run rest
    [] => fail_with usage
