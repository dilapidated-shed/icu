module Main

import Http
import OpenAI
import System
import System.File
import Transport


usage : String
usage =
  "usage:\n" ++
  "  icu get  [-H 'Name: value']... http://host/path\n" ++
  "  icu get  [-H 'Name: value']... https://host/path\n" ++
  "  icu post [-H 'Name: value']... http://host/path BODY\n" ++
  "  icu post [-H 'Name: value']... https://host/path BODY\n" ++
  "  icu openai < prompt.txt"

collect_headers :
  List String → List request_header → Either String (List request_header, List String)
collect_headers [] headers = Right (reverse headers, [])
collect_headers ("-H" :: value :: rest) headers =
  case parse_header value of
    Left problem => Left problem
    Right parsed => collect_headers rest (parsed :: headers)
collect_headers ("--header" :: value :: rest) headers =
  case parse_header value of
    Left problem => Left problem
    Right parsed => collect_headers rest (parsed :: headers)
collect_headers ["-H"] _ = Left "-H requires a Name: value argument"
collect_headers ["--header"] _ = Left "--header requires a Name: value argument"
collect_headers arguments headers = Right (reverse headers, arguments)

parse_command : List String → Either String (request, List request_header)
parse_command ("get" :: arguments) =
  case collect_headers arguments [] of
    Left problem => Left problem
    Right (headers, [text]) =>
      case parse_url text of
        Left problem => Left problem
        Right target_url => Right (get target_url, headers)
    Right _ => Left usage
parse_command ("post" :: arguments) =
  case collect_headers arguments [] of
    Left problem => Left problem
    Right (headers, [text, body]) =>
      case parse_url text of
        Left problem => Left problem
        Right target_url => Right (post target_url body, headers)
    Right _ => Left usage
parse_command _ = Left usage

fail_with : String → IO ()
fail_with problem = do
  _ ← fPutStrLn stderr problem
  exitFailure

run_openai : IO ()
run_openai = do
  outcome ← query_stdin
  case outcome of
    Left problem => fail_with problem
    Right answer => putStr answer

run : List String → IO ()
run ["openai"] = run_openai
run arguments =
  case parse_command arguments of
    Left problem => fail_with problem
    Right (value, headers) => do
      outcome ← send_request_with_headers value headers
      case outcome of
        Left problem => fail_with problem
        Right status => exitWith (cast status)

main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    _ :: rest => run rest
    [] => fail_with usage
