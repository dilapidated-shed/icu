module Main

import Network.HTTP
import Network.Transport
import Network.Types
import Network.URL
import System
import Transport


usage : String
usage =
  "usage:\n" ++
  "  icu get  http://host/path\n" ++
  "  icu get  https://host/path\n" ++
  "  icu post http://host/path BODY\n" ++
  "  icu post https://host/path BODY"

parse_command : List String → Either String request
parse_command ["get", text] =
  case parse_url text of
    Left problem => Left problem
    Right target_url => Right (get target_url)
parse_command ["post", text, body] =
  case parse_url text of
    Left problem => Left problem
    Right target_url => Right (post target_url (http_body_from_string body))
parse_command _ = Left usage

fail_with : String → IO ()
fail_with problem = do
  putStrLn problem
  exitFailure

run : List String → IO ()
run arguments =
  case parse_command arguments of
    Left problem => fail_with problem
    Right value => do
      outcome ← send_request value
      case outcome of
        Left problem => fail_with problem
        Right result => exitWith (process_exit_status result)

main : IO ()
main = do
  arguments ← getArgs
  case arguments of
    _ :: rest => run rest
    [] => fail_with usage
