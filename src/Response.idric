module Response

import Data.Text
import Data.List
import Data.List1
import Data.Buffer
import Network.HTTP
import Network.Types
import Network.URL
import System.File
import System.File.Buffer
import System.Directory

-- OS failure is part of the effectful result, not a totality promise.
%default covering

public export
record HTTPResponse where
  constructor Make_HTTP_Response
  status : Int
  body : Text

public export
data CaptureFailure = InvalidRequest | ConnectionFailure | TLSFailure
                    | RequestWriteFailure | MalformedResponse | RedirectFailure
                    | TruncatedResponse | Timeout | ResourceLimit
                    | CaptureIOFailure | InvalidUTF8 | UnsupportedEncoding
                    | ProxyFailure

public export
failure_description : CaptureFailure → Text
failure_description InvalidRequest = "invalid request headers"
failure_description ConnectionFailure = "ICU connection failed"
failure_description TLSFailure = "ICU TLS verification or handshake failed"
failure_description RequestWriteFailure = "ICU request write failed"
failure_description MalformedResponse = "ICU malformed or unsupported HTTP framing"
failure_description RedirectFailure = "ICU redirect failed"
failure_description TruncatedResponse = "ICU response body length mismatch"
failure_description Timeout = "ICU request timed out"
failure_description ResourceLimit = "ICU captured response exceeds 8 MiB"
failure_description CaptureIOFailure = "ICU private response capture failed"
failure_description InvalidUTF8 = "ICU response is not valid UTF-8"
failure_description UnsupportedEncoding = "ICU response encoding is unsupported"
failure_description ProxyFailure = "ICU HTTPS proxy tunnel failed"

public export
record HTTPBytesResponse where
  constructor Make_HTTP_Bytes_Response
  status : Int
  body_bytes : Buffer
  encoding : Text
  content_type : Text
  utf8_valid : Bool
  content_range : Text
  resolved_url : Text
  redirect_count : Number

capture_failure : Int → CaptureFailure
capture_failure 2 = InvalidRequest
capture_failure 3 = InvalidRequest
capture_failure 4 = ConnectionFailure
capture_failure 5 = TLSFailure
capture_failure 6 = RequestWriteFailure
capture_failure 8 = RedirectFailure
capture_failure 9 = TruncatedResponse
capture_failure 11 = Timeout
capture_failure 12 = ResourceLimit
capture_failure 13 = MalformedResponse
capture_failure 14 = ProxyFailure
capture_failure 15 = UnsupportedEncoding
capture_failure _ = CaptureIOFailure

-- The existing ICU socket/OpenSSL provider owns these calls. Private temporary
-- directories prevent PID collisions and hostile pre-existing response files.
%foreign "C:icu_response_directory,libicu_transport"
primitive_response_directory : PrimIO Text

%foreign "C:icu_fetch_http_with_credentials,libicu_transport"
primitive_fetch_http : Text → Int → Text → Text → Int → Text → Text → Text → PrimIO Int

%foreign "C:icu_fetch_https_with_credentials,libicu_transport"
primitive_fetch_https : Text → Int → Text → Text → Int → Text → Text → Text → PrimIO Int

credential_names : List HeaderName → Text
credential_names names = concatMap (\name ⇒ header_name_text name ++ "\n") names

fetch_prepared : url → RenderedRequest → Text → Text → Text → IO Int
fetch_prepared (http_url name port _) wire body_path metadata_path credentials =
  primIO (primitive_fetch_http (host_name_string name) (cast (destination_port_number port))
    (http_request_head_text (rendered_request_head wire)) (http_body_string (rendered_request_body wire))
    (cast (byte_count_number (rendered_request_body_length wire))) body_path metadata_path credentials)
fetch_prepared (https_url name port _) wire body_path metadata_path credentials =
  primIO (primitive_fetch_https (host_name_string name) (cast (destination_port_number port))
    (http_request_head_text (rendered_request_head wire)) (http_body_string (rendered_request_body wire))
    (cast (byte_count_number (rendered_request_body_length wire))) body_path metadata_path credentials)

metadata_fields : Text → List (Text, Text)
metadata_fields text = mapMaybe row (lines text)
  where
    row : Text → Maybe (Text, Text)
    row line = case forget (split (≟ '\t') line) of
      [key, value] ⇒ Just (key, value)
      _ ⇒ Nothing

understand_bytes : Int → Text → Buffer → Either CaptureFailure HTTPBytesResponse
understand_bytes transport_code metadata bytes =
  if not (transport_code ≟ 0 || transport_code ≟ 10) then Left (capture_failure transport_code)
  else let fields = metadata_fields metadata in
    case (lookup "http_status" fields, lookup "utf8" fields,
          lookup "content_encoding" fields, lookup "content_type" fields) of
      (Just status_text, Just utf8, Just encoding, Just content_type) ⇒
        case (lookup "content_range" fields, lookup "resolved_url" fields,
              lookup "redirect_count" fields) of
          (Just content_range, Just resolved_url, Just redirects) ⇒
            let status : Int = cast status_text in
              if length status_text ≟ 3 && all isDigit (unpack status_text) && status >= 100 && status <= 599
              then if length redirects > 0 && all isDigit (unpack redirects) && cast {to = Number} redirects <= 8
                then Right (Make_HTTP_Bytes_Response status bytes encoding content_type (utf8 ≟ "valid")
                  content_range resolved_url (cast redirects))
                else Left MalformedResponse
              else Left MalformedResponse
          _ ⇒ Left MalformedResponse
      _ ⇒ Left MalformedResponse

supported_charset : Text → Bool
supported_charset content_type = all allowed (drop 1 (forget (split (≟ ';') content_type)))
  where
    allowed : Text → Bool
    allowed parameter =
      case map (toLower . trim) (forget (split (≟ '=') parameter)) of
        ["charset", value] ⇒ elem value ["utf-8", "\"utf-8\"", "us-ascii", "\"us-ascii\""]
        ["charset"] ⇒ False
        _ ⇒ True

public export
response_text : HTTPBytesResponse → IO (Either CaptureFailure HTTPResponse)
response_text captured =
  if toLower captured.encoding /= "identity" || not (supported_charset captured.content_type)
    then pure (Left UnsupportedEncoding)
  else if not captured.utf8_valid then pure (Left InvalidUTF8)
  else do
    size ← rawSize captured.body_bytes
    body ← getString captured.body_bytes 0 size
    pure (Right (Make_HTTP_Response captured.status body))

public export
fetch_bytes_response_at_version : http_version → request → List request_header → IO (Either CaptureFailure HTTPBytesResponse)
fetch_bytes_response_at_version version value headers = case render_request_parts_at_version version value headers of
  Left _ ⇒ pure (Left InvalidRequest)
  Right wire ⇒ do
    directory ← primIO primitive_response_directory
    if directory ≟ "" then pure (Left CaptureIOFailure) else do
      let body_path = directory ++ "/body"
      let metadata_path = directory ++ "/metadata"
      result ← fetch_prepared (request_url value) wire body_path metadata_path (credential_names (credential_header_names headers))
      body ← if result ≟ 0 || result ≟ 10 then createBufferFromFile body_path
              else pure (Left FileReadError)
      metadata ← readFile metadata_path
      _ ← removeFile body_path
      _ ← removeFile metadata_path
      removeDir directory
      pure (case (body, metadata) of
        (Right body, Right metadata) ⇒ understand_bytes result metadata body
        _ ⇒ if result ≟ 0 || result ≟ 10 then Left CaptureIOFailure
             else Left (capture_failure result))

public export
fetch_bytes_response : request → List request_header → IO (Either CaptureFailure HTTPBytesResponse)
fetch_bytes_response = fetch_bytes_response_at_version http_one_zero

number : Text → Maybe Number
number text = if length text > 0 && all isDigit (unpack text)
  then Just (cast text) else Nothing

public export
range_matches : Number → Number → Text → Bool
range_matches start size value = size > 0 && case forget (split (≟ ' ') value) of
  ["bytes", interval] ⇒ case forget (split (≟ '/') interval) of
    [bounds, total_text] ⇒ case forget (split (≟ '-') bounds) of
      [first, last] ⇒ case (number first, number last, number total_text) of
        (Just actual_start, Just actual_end, Just actual_total) ⇒
          actual_start ≟ start && actual_end + 1 ≟ start + size && actual_total > actual_end
        _ ⇒ False
      _ ⇒ False
    _ ⇒ False
  _ ⇒ False

-- Exact finite ranges are interpreted here, in Idriç, against the captured
-- entity bytes. A successful socket operation alone never admits a range.
public export
fetch_range_response : url → Number → Number → IO (Either CaptureFailure HTTPBytesResponse)
fetch_range_response destination start size =
  if size ≟ 0 || size > 8388608 then pure (Left InvalidRequest) else
  case make_header "Range" ("bytes=" ++ show start ++ "-" ++ show (minus (start + size) 1)) of
    Left _ ⇒ pure (Left InvalidRequest)
    Right header ⇒ do
      captured ← fetch_bytes_response_at_version http_one_one (get destination) [header]
      case captured of
        Left failure ⇒ pure (Left failure)
        Right response ⇒ do
          actual_size ← rawSize response.body_bytes
          pure (if response.status ≟ 206 && toLower response.encoding ≟ "identity" &&
                   cast {to = Number} actual_size ≟ size && range_matches start size response.content_range
            then Right response else Left MalformedResponse)

-- Existing clients keep their text API, while binary callers request bytes.
public export
fetch_response : request → List request_header → IO (Either Text HTTPResponse)
fetch_response value headers = do
  captured ← fetch_bytes_response value headers
  case captured of
    Left failure ⇒ pure (Left (failure_description failure))
    Right bytes ⇒ do
      decoded ← response_text bytes
      pure (case decoded of
        Left failure ⇒ Left (failure_description failure)
        Right response ⇒ Right response)
