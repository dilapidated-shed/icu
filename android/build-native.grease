#!/usr/bin/env grease
# Build host entrypoint; Make owns the one NDK/OpenSSL build recipe.
var root = "$(realpath "$(dirname "$0")/..")"
if (int($#) !== 2) { echo 'requires OUTPUT_LIBRARY PINNED_OPENSSL_SOURCE' >&2; exit 2 }
make -f "$root/android/Makefile" \
  "OUTPUT=$(realpath -m "$1")" "OPENSSL_SOURCE=$(realpath "$2")" \
  "ANDROID_NDK_HOME=$[get(ENV, 'ANDROID_NDK_HOME', '')]" \
  "ANDROID_ABI=$[get(ENV, 'ANDROID_ABI', 'armeabi-v7a')]" \
  "ANDROID_API=$[get(ENV, 'ANDROID_API', '24')]"
